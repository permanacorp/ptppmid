# Environment Configuration Template
CI_ENV=production

# App Base URL (e.g. https://ptppm.id/ or leave blank for auto-detection)
APP_BASE_URL=

# Application Encryption Key (Generate a 64-char hex string)
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Database Configuration (External / Shared MariaDB)
DB_HOSTNAME=mariadb-shared-host
DB_PORT=3306
DB_USERNAME=ptppmid_user
DB_PASSWORD=your_strong_password
DB_DATABASE=ptppmid_db
DB_DRIVER=mysqli

# Email SMTP Credentials (Gmail App Password or Custom SMTP)
SMTP_HOST=ssl://smtp.googlemail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_PORT=465
SMTP_CRYPTO=ssl

# Google reCAPTCHA v2 Secret Key
RECAPTCHA_SECRET=your_recaptcha_secret_key_here

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
